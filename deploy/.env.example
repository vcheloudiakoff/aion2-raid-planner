# Modèle de deploy/.env (non versionné, à côté de docker-compose.yml sur le NAS).
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# Une valeur vide vaut absente : le défaut indiqué s'applique. Aucune valeur secrète ici.

# --- Obligatoires (le compose refuse de démarrer sans elles) ---

# URL publique de l'outil, seule source d'URL absolue (AD-9). Exemple : https://raid.example.org
PUBLIC_BASE_URL=
# Clé HMAC du jeton de formulaire, au moins 32 octets. Générer avec :
#   head -c 48 /dev/urandom | base64 | tr -d '\n'
FORM_TOKEN_SECRET=

# --- Facultatives (défaut entre parenthèses) ---

# Port hôte, lié à 127.0.0.1 seulement ; le conteneur écoute toujours 8080 (8080).
PORT=
# En-tête mono-valeur posé par l'edge avec l'IP du client, jamais X-Forwarded-For (X-Client-IP).
CLIENT_IP_HEADER=
# false réservé au poste de développement : repli sur l'adresse du pair (true).
TRUST_CLIENT_IP_HEADER=
# Âge minimal du jeton de formulaire, en millisecondes (3000).
MIN_SUBMIT_DELAY_MS=
# Disjoncteurs globaux, comptés sur les écritures commises (30 et 300).
MAX_EVENTS_PER_HOUR=
MAX_CANDIDATURES_PER_HOUR=
# Quotas par IP et par classe de route, forme <nombre>/<s|min|h> (5/h, 20/h, 120/min, 600/min).
RATE_CREATE=
RATE_CANDIDATURE=
RATE_WRITE=
RATE_READ=
# Niveau de journal : off, error, warn ou info ; debug et trace refusés en production (info).
RUST_LOG=
# Gabarit du nom de salle tapé en jeu (AD-18). Vide = défaut `{label}-{code}`. Jetons : {label},
# {code} (exactement une fois). Un gabarit invalide ou trop long empêche le démarrage.
ROOM_NAME_TEMPLATE=
