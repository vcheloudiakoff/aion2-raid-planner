# BMAD : réponses d'install personnelles, régénérées par l'installeur, propres à chaque dev.
# (_bmad/custom/*.user.toml et _bmad/render/ ont déjà leur propre .gitignore.)
_bmad/config.user.toml

# Secrets et environnement
.env
.env.*
!.env.example

# Dépendances et builds
node_modules/
target/
# Build Vite : seul web/dist/.gitkeep est versionné, pour que `cargo check` passe sans build web.
/web/dist/*
!/web/dist/.gitkeep

# OS, éditeurs, Claude Code local
.DS_Store
*.swp
.idea/
.vscode/
.claude/settings.local.json
.claude/worktrees/
